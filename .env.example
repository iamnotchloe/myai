# 复制为 .env，再填入你自己的 SiliconFlow API 密钥。
SILICONFLOW_API_KEY=

# 可选配置：不填时使用项目默认值。
EMBEDDING_MODEL_NAME_OR_PATH=BAAI/bge-small-zh-v1.5
BACKEND_PORT=8001
BACKEND_BASE_URL=http://127.0.0.1:8001

# 检索参数：这些是当前开发基线，后续应使用开发集调参。
DENSE_TOP_K=10
BM25_TOP_K=20
FUSED_TOP_K=30
RERANK_TOP_N=3
RRF_K=5
DENSE_RRF_WEIGHT=3.0
BM25_RRF_WEIGHT=1.0
RERANK_RELEVANCE_MIN_SCORE=0.15
EMBEDDING_RELEVANCE_MIN_SCORE=0.35
RERANK_TIMEOUT_SECONDS=10
