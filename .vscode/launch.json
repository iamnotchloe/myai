{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MyAI：启动后端",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/fastapi_app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "MyAI：启动前端",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/streamlit_app.py",
        "--server.port",
        "8501"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      "name": "MyAI：重建索引（仅需要时）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/build.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "MyAI：启动完整项目",
      "configurations": [
        "MyAI：启动后端",
        "MyAI：启动前端"
      ],
      "stopAll": true
    }
  ]
}
